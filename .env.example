# ---------------------------------------------------------------------------
# House3 - environment template. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# Canonical database. Local development uses docker-compose on port 5433.
# Production should set this from the deployment secret store to the managed
# PostgreSQL provider (Aiven/Neon/etc.) with SSL enabled. Never commit the URL.
DATABASE_URL="postgresql://house3:house3@localhost:5433/house3?schema=public"

# Turso is intentionally not the canonical House3 database. Do not set these
# until a separate edge/read-model adapter is implemented and reviewed.
# TURSO_DATABASE_URL=""
# TURSO_AUTH_TOKEN=""

# Public base URL used to build Paystack/Flutterwave callback URLs
APP_BASE_URL="http://localhost:3000"

# --- Paystack (primary processor: supports subaccounts + split natively) ----
PAYSTACK_SECRET_KEY="sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
# Paystack signs webhooks with your secret key using HMAC-SHA512
PAYSTACK_WEBHOOK_SECRET="sk_test_xxx"

# --- Flutterwave (secondary / fallback: subaccounts + transaction_split) ----
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxx"
FLUTTERWAVE_WEBHOOK_HASH="your-webhook-hash"

# --- Platform money configuration -------------------------------------------
# Default service fee applied when no state/partner override exists.
DEFAULT_FEE_RATE_BPS="1000"          # 1000 bps = 10.0% of the room subtotal
DEFAULT_FEE_MIN_KOBO="200000"        # floor: NGN 2,000
DEFAULT_FEE_MAX_KOBO="4000000"       # cap : NGN 40,000
PLATFORM_VAT_RATE_BPS="750"          # 7.5% Nigerian VAT, charged on OUR fee only
PRICE_ROUNDING_STEP_KOBO="5000"      # display rounding: NGN 50

# Processor fee model used to forecast the platform's net margin
PAYSTACK_FEE_RATE_BPS="150"          # 1.5%
PAYSTACK_FEE_FLAT_KOBO="10000"       # NGN 100
PAYSTACK_FEE_CAP_KOBO="200000"       # NGN 2,000 cap on local NGN cards

# Which party absorbs the processor fee: "platform" | "partner"
PROCESSOR_FEE_BEARER="platform"

# Rollout gate: only states with this flag live are exposed in search.
ROLLOUT_MODE="phased"
# How many launch states are open, by launchOrder. 1 = Lagos only, 5 = all five.
# SET THIS EXPLICITLY IN EVERY ENVIRONMENT. An unset value falls back to 5 in the
# code, which would expose all five configured states at once. Lagos-only is the
# intended launch posture: one state is one crawl, one set of partners, and one
# place to find out whether the funnel works before repeating it four times.
LAST_LIVE_LAUNCH_ORDER="1"

# ---------------------------------------------------------------------------
# STAGING ONLY. Simulates successful charges so the funnel can be walked before
# a merchant account exists. Never enable alongside live keys, and unset it
# before you take real money.
# ---------------------------------------------------------------------------
ALLOW_DEMO_PAYMENTS="false"

# ---------------------------------------------------------------------------
# Partner acquisition (services/acquisition). All optional: the pipeline runs
# with `--transport stdlib` / `--transport fixture` and no keys at all.
# ---------------------------------------------------------------------------

# Managed scraping. Pays per scrape and does the browser work for us, so we do
# not operate a Playwright fleet. Note this does NOT change our obligations:
# robots.txt and the field allowlist still run on whatever it returns.
FIRECRAWL_API_KEY=""

# Semantic discovery - finds operators our sitemap walk cannot see. The pipeline
# derives its structured-output schema from ALLOWED_FIELDS, so asking a search
# API for descriptions or images is impossible by construction.
EXA_API_KEY=""
