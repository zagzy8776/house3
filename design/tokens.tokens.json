{
  "color": {
    "primitive": {
      "green": {
        "50": { "$type": "color", "$value": "#E9F7F0", "$description": "Tinted backgrounds, selected rows" },
        "100": { "$type": "color", "$value": "#C9EBD9" },
        "300": { "$type": "color", "$value": "#6FC79A", "$description": "Borders on tinted surfaces" },
        "500": { "$type": "color", "$value": "#128A4E", "$description": "Primary action. Deliberately not the blue Airbnb/Booking own, nor Agoda purple." },
        "700": { "$type": "color", "$value": "#0A6136", "$description": "Pressed state, accessible text on tint" },
        "900": { "$type": "color", "$value": "#063C22", "$description": "Wordmark, headings on light" }
      },
      "ink": {
        "900": { "$type": "color", "$value": "#10161A", "$description": "Primary text" },
        "700": { "$type": "color", "$value": "#3A4750", "$description": "Secondary text" },
        "500": { "$type": "color", "$value": "#6B7A85", "$description": "Tertiary text, labels" },
        "300": { "$type": "color", "$value": "#AEBBC4", "$description": "Disabled, placeholder" },
        "100": { "$type": "color", "$value": "#E4EAEE", "$description": "Borders, dividers" },
        "50":  { "$type": "color", "$value": "#F4F7F9", "$description": "Page background" },
        "white": { "$type": "color", "$value": "#FFFFFF" }
      },
      "amber": {
        "500": { "$type": "color", "$value": "#E8A33D", "$description": "Scarcity flag, hold banner background, icon fill" },
        "700": { "$type": "color", "$value": "#8A5A12", "$description": "Amber TEXT on light. amber.500 as text is only ~2:1 contrast, so urgent copy must use this." },
        "50":  { "$type": "color", "$value": "#FDF3E3" }
      },
      "red": {
        "500": { "$type": "color", "$value": "#C4342B", "$description": "Failure, validation, declined payment" },
        "50":  { "$type": "color", "$value": "#FDECEA" }
      }
    },

    "semantic": {
      "bg": {
        "page":       { "$type": "color", "$value": "{color.primitive.ink.50}" },
        "surface":    { "$type": "color", "$value": "{color.primitive.ink.white}" },
        "sunken":     { "$type": "color", "$value": "{color.primitive.ink.100}" },
        "brand-tint": { "$type": "color", "$value": "{color.primitive.green.50}" },
        "danger-tint":{ "$type": "color", "$value": "{color.primitive.red.50}" }
      },
      "text": {
        "primary":   { "$type": "color", "$value": "{color.primitive.ink.900}" },
        "secondary": { "$type": "color", "$value": "{color.primitive.ink.700}" },
        "tertiary":  { "$type": "color", "$value": "{color.primitive.ink.500}" },
        "disabled":  { "$type": "color", "$value": "{color.primitive.ink.300}" },
        "on-brand":  { "$type": "color", "$value": "{color.primitive.ink.white}" },
        "brand":     { "$type": "color", "$value": "{color.primitive.green.700}" },
        "danger":    { "$type": "color", "$value": "{color.primitive.red.500}" }
      },
      "border": {
        "default": { "$type": "color", "$value": "{color.primitive.ink.100}" },
        "strong":  { "$type": "color", "$value": "{color.primitive.ink.300}" },
        "brand":   { "$type": "color", "$value": "{color.primitive.green.300}" }
      },
      "action": {
        "primary-bg":         { "$type": "color", "$value": "{color.primitive.green.500}" },
        "primary-bg-pressed": { "$type": "color", "$value": "{color.primitive.green.700}" },
        "primary-text":       { "$type": "color", "$value": "{color.primitive.ink.white}" },
        "secondary-bg":       { "$type": "color", "$value": "{color.primitive.ink.white}" },
        "secondary-text":     { "$type": "color", "$value": "{color.primitive.green.700}" }
      },
      "money": {
        "operator-row":    { "$type": "color", "$value": "{color.primitive.ink.900}", "$description": "What the operator charges - the anchor the guest compares against" },
        "fee-row":         { "$type": "color", "$value": "{color.primitive.ink.900}", "$description": "Our fee. Deliberately NOT styled as a warning: we are not hiding it, so it must not read as a penalty." },
        "tax-row":         { "$type": "color", "$value": "{color.primitive.ink.700}", "$description": "VAT. Muted, because it is the government's line, not ours." },
        "discount-row":    { "$type": "color", "$value": "{color.primitive.green.700}" },
        "total-row":       { "$type": "color", "$value": "{color.primitive.ink.900}" },
        "settlement-note": { "$type": "color", "$value": "{color.primitive.ink.500}", "$description": "'Operator receives X, House3 keeps Y'" }
      }
    }
  },

  "typography": {
    "family": {
      "base": {
        "$type": "fontFamily",
        "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "$description": "System stack on purpose: no webfont request. Saves data on metered Nigerian mobile plans and renders instantly on low-end Android."
      }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "display": { "$type": "fontSize", "$value": "28px" },
      "h1":      { "$type": "fontSize", "$value": "22px" },
      "h2":      { "$type": "fontSize", "$value": "18px" },
      "body":    { "$type": "fontSize", "$value": "15px" },
      "small":   { "$type": "fontSize", "$value": "13px" },
      "micro":   { "$type": "fontSize", "$value": "11px" },
      "money":   { "$type": "fontSize", "$value": "15px", "$description": "Money rows never drop below body size. Misreading a price is the one error we cannot ship." }
    },
    "lineHeight": {
      "tight":  { "$type": "lineHeight", "$value": "1.15" },
      "snug":   { "$type": "lineHeight", "$value": "1.3" },
      "normal": { "$type": "lineHeight", "$value": "1.45" }
    }
  },

  "space": {
    "0":  { "$type": "dimension", "$value": "0px" },
    "1":  { "$type": "dimension", "$value": "2px" },
    "2":  { "$type": "dimension", "$value": "4px" },
    "3":  { "$type": "dimension", "$value": "8px" },
    "4":  { "$type": "dimension", "$value": "12px" },
    "5":  { "$type": "dimension", "$value": "16px" },
    "6":  { "$type": "dimension", "$value": "20px" },
    "7":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "9":  { "$type": "dimension", "$value": "40px" },
    "10": { "$type": "dimension", "$value": "48px" }
  },

  "radius": {
    "sm":   { "$type": "dimension", "$value": "4px" },
    "md":   { "$type": "dimension", "$value": "8px" },
    "lg":   { "$type": "dimension", "$value": "12px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },

  "size": {
    "touchTarget":  { "$type": "dimension", "$value": "44px", "$description": "Minimum. Thumbs on a 360px Android, one-handed." },
    "buttonHeight": { "$type": "dimension", "$value": "48px" },
    "inputHeight":  { "$type": "dimension", "$value": "44px" },
    "viewportBase": { "$type": "dimension", "$value": "360px", "$description": "Design baseline: the most common cheap-Android width in Nigeria." },
    "contentMax":   { "$type": "dimension", "$value": "720px" }
  },

  "shadow": {
    "sm":     { "$type": "boxShadow", "$value": { "x": "0", "y": "1px", "blur": "2px", "spread": "0", "color": "#10161A0F" }, "$description": "Subtle only. Heavy shadows wash out on low-quality screens and cost paint time." },
    "md":     { "$type": "boxShadow", "$value": { "x": "0", "y": "4px", "blur": "12px", "spread": "0", "color": "#10161A1A" } },
    "sticky": { "$type": "boxShadow", "$value": { "x": "0", "y": "-2px", "blur": "8px", "spread": "0", "color": "#10161A14" }, "$description": "Rising shadow for the sticky checkout bar" }
  },

  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" }
  }
}
