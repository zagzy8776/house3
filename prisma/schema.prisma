// House3 production data model.
//
// Design notes:
//  * All money columns are Int, denominated in KOBO. Never Float.
//  * `partnerNetKobo` / `platformNetKobo` / `processorFeeKobo` are stored on the
//    booking itself so the split is reproducible years later, even if fee
//    policies change. Quotes are frozen at checkout time.
//  * PartnerChannel.authorizationReference + expiresAt is what makes an
//    inventory source legal: no authorization row, no sync.
//  * InventoryPartner is always named in the customer UI. There is deliberately
//    no "anonymous supplier" concept in this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Geography & rollout
// ---------------------------------------------------------------------------

model State {
  code        String      @id // "LA", "FC", "OY", "IM", "AK"
  name        String
  phase       Int
  launchOrder Int         @unique
  status      StateStatus @default(PENDING)
  primaryCity String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  areas      Area[]
  partners   InventoryPartner[]
  policies   FeePolicy[]
  locations  Location[]
  properties Property[]
  operators  Operator[]

  @@index([status, launchOrder])
}

enum StateStatus {
  PENDING
  SUPPLY_ONBOARDING
  LIVE
  PAUSED
}

model Area {
  id        String   @id @default(cuid())
  stateCode String
  name      String
  /// Sort order for the search dropdown; demand-weighted, not alphabetical.
  rank      Int      @default(100)
  createdAt DateTime @default(now())

  state    State              @relation(fields: [stateCode], references: [code])
  // Areas belong to a state; partners and units point back at an Area.
  partners InventoryPartner[]

  @@unique([stateCode, name])
  @@index([stateCode, rank])
}

/// A normalized locality used by discovery and canonical properties. `Area` is
/// still the rollout/search-dropdown table; Location is the durable geography
/// identity that may later carry LGA and geocoder metadata.
model Location {
  id             String   @id @default(cuid())
  stateCode      String
  name           String
  normalizedName String
  city           String?
  lga            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  state      State           @relation(fields: [stateCode], references: [code])
  properties Property[]
  listings   SourceListing[]
  geocodes   GeocodeRecord[]

  @@unique([stateCode, normalizedName])
  @@index([stateCode, name])
}

/// A business/operator identity, separate from a physical property. Names are
/// intentionally not unique: two unrelated operators can use the same name.
model Operator {
  id              String   @id @default(cuid())
  /// Deterministic key from the acquisition dedupe pass. Display names are not
  /// unique, but an explicit dedupe key makes repeat ingestion idempotent.
  operatorKey     String?  @unique
  displayName     String?
  normalizedName  String
  phoneNormalized String?
  email           String?
  websiteDomain   String?
  stateCode       String?
  partnerId       String?
  firstSeenAt     DateTime
  lastSeenAt      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  state      State?            @relation(fields: [stateCode], references: [code])
  partner    InventoryPartner? @relation(fields: [partnerId], references: [id])
  properties Property[]
  listings   SourceListing[]

  @@index([normalizedName, stateCode])
  @@index([phoneNormalized])
  @@index([email])
}

enum PropertyVerificationStatus {
  DISCOVERED
  NORMALIZED
  GEOCODED
  DEDUPLICATED
  DATABASE
  PUBLISHED
  VERIFIED
  BOOKABLE
}

enum LocationPrecision {
  ROOFTOP
  ADDRESS
  STREET
  NEIGHBORHOOD
  CITY
  STATE
  UNKNOWN
}

/// One physical accommodation. A discovery record is not automatically made
/// into a Property: SourceListing.propertyId remains nullable until evidence is
/// sufficient to avoid manufacturing duplicate apartments.
model Property {
  id                       String                                 @id @default(cuid())
  canonicalName            String?
  propertyType             String?
  bedrooms                 Int?
  bathrooms                Int?
  maxGuests                Int?
  stateCode                String?
  locationId               String?
  addressLine              String?
  city                     String?
  latitude                 Float?
  longitude                Float?
  /// PostGIS geography(Point, 4326). Prisma cannot read/write this field;
  /// ingestion writes it with ST_SetSRID(ST_MakePoint(...), 4326)::geography.
  geog                     Unsupported("geography(Point, 4326)")?
  locationPrecision        LocationPrecision?
  geocodeConfidence        Int?
  geocodeProvider          String?
  geocodedAt               DateTime?
  verificationStatus       PropertyVerificationStatus             @default(DISCOVERED)
  canonicalSourceListingId String?
  operatorId               String?
  createdAt                DateTime                               @default(now())
  updatedAt                DateTime                               @updatedAt

  state          State?               @relation(fields: [stateCode], references: [code])
  location       Location?            @relation(fields: [locationId], references: [id])
  operator       Operator?            @relation(fields: [operatorId], references: [id])
  sourceListings SourceListing[]
  prices         PriceObservation[]
  geocodes       GeocodeRecord[]
  amenities      PropertyAmenity[]
  availability   AvailabilitySignal[]

  @@index([stateCode, verificationStatus])
  @@index([locationId, verificationStatus])
  @@index([operatorId])
}

enum SourceAccessMethod {
  PUBLIC_WEB
  API
  FEED
  MANUAL
}

enum SourceTermsStatus {
  UNREVIEWED
  PERMITTED
  RESTRICTED
  PROHIBITED
}

/// Permission and provenance registry for every discovery source.
model SourceRegistry {
  id                     String             @id @default(cuid())
  key                    String             @unique
  displayName            String
  ownerLegalName         String?
  regions                String[]
  accessMethod           SourceAccessMethod
  termsStatus            SourceTermsStatus  @default(UNREVIEWED)
  termsUrl               String?
  robotsPolicySnapshot   String?
  attributionRequirement String?
  rateLimitPerMinute     Int?
  contactEmail           String?
  lastReviewedAt         DateTime?
  reviewedBy             String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  listings SourceListing[]
}

/// The unit an advertised price is quoted in. A Nigerian portal states shortlets
/// "per day", rentals "per annum" and furnished lets "per month", so a nightly
/// rate and an annual rent are only comparable once this is known - leaving both
/// as UNKNOWN would put a NGN 500,000 night and a NGN 500,000 year side by side.
/// "per day" is PER_NIGHT: one day's stay is one night, and two values for one
/// rate would have to be reconciled by every later calculation.
enum PriceBasis {
  PER_NIGHT
  PER_WEEK
  PER_MONTH
  PER_YEAR
  PER_STAY
  PER_PERSON_NIGHT
  UNKNOWN
}

/// Source-scoped crawl record. The physical table name is retained for a safe
/// transition from the original prospect schema.
model SourceListing {
  id                  String     @id @default(cuid())
  source              String
  sourceListingId     String
  sourceUrl           String
  propertyId          String?
  operatorId          String?
  sourceRegistryId    String?
  locationId          String?
  city                String?
  firstSeenAt         DateTime
  lastSeenAt          DateTime
  /// Observed advertised figure in kobo, as stated by the source. BigInt rather
  /// than Int on purpose: this is an uncontrolled third-party number. NPC quotes
  /// short-lets "per day" but also "per annum", and non-short-let templates quote
  /// land in the billions, so an int4 ceiling (NGN 21,474,836) would abort a run
  /// on one outlier. Bookable money stays Int kobo - see Unit, where the pricing
  /// funnel guarantees the range. Discovery and bookable inventory do not share
  /// a type, because they do not share a trust boundary.
  advertisedPriceKobo BigInt?
  currency            String     @default("NGN")
  priceBasis          PriceBasis @default(UNKNOWN)
  bedrooms            Int?
  bathrooms           Int?
  area                String?
  stateCode           String?
  operatorKey         String?
  operatorName        String?
  rawSnapshotRef      String?
  parserVersion       String?
  normalizedAt        DateTime?
  rawFacts            Json?
  provenance          Json?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  property     Property?              @relation(fields: [propertyId], references: [id])
  operator     Operator?              @relation(fields: [operatorId], references: [id])
  registry     SourceRegistry?        @relation(fields: [sourceRegistryId], references: [id])
  location     Location?              @relation(fields: [locationId], references: [id])
  observations SourceObservation[]
  prices       PriceObservation[]
  amenities    SourceListingAmenity[]
  geocodes     GeocodeRecord[]

  @@unique([source, sourceListingId])
  @@index([lastSeenAt])
  @@index([propertyId])
  @@index([operatorKey])
  @@index([stateCode, area])
  @@map("ProspectListing")
}

/// Append-only normalized source sighting. A rerun of one listing on one
/// timestamp is idempotent; a later observation is a new row.
model SourceObservation {
  id              String   @id @default(cuid())
  sourceListingId String
  observedAt      DateTime
  normalizedFacts Json
  rawFacts        Json?
  provenance      Json
  createdAt       DateTime @default(now())

  sourceListing SourceListing @relation(fields: [sourceListingId], references: [id])

  @@unique([sourceListingId, observedAt])
  @@index([observedAt])
  @@map("ProspectObservation")
}

/// Append-only price history. Prices are observations of a source, not House3
/// bookable rates.
model PriceObservation {
  id              String     @id @default(cuid())
  propertyId      String?
  sourceListingId String
  /// Observed amount in kobo. BigInt for the same reason as
  /// SourceListing.advertisedPriceKobo: observed, not quoted by House3.
  amountKobo      BigInt?
  currency        String     @default("NGN")
  basis           PriceBasis @default(UNKNOWN)
  nights          Int?
  guests          Int?
  taxesIncluded   Boolean?
  feesIncluded    Boolean?
  observedAt      DateTime
  sourceUrl       String
  createdAt       DateTime   @default(now())

  property      Property?     @relation(fields: [propertyId], references: [id])
  sourceListing SourceListing @relation(fields: [sourceListingId], references: [id])

  @@unique([sourceListingId, observedAt])
  @@index([propertyId, observedAt])
  @@index([observedAt])
}

enum GeocodeReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
  NEEDS_REVIEW
}

/// Which kind of thing a geocode describes.
///
/// A geocode is evidence, and evidence arrives before the canonical answer: a
/// source listing (or a normalised Location) is geocoded first, and entity
/// resolution then decides which canonical Property the coordinates belong to -
/// coordinates being one of the matching signals. Keying a geocode to a Property
/// only, as this model originally did, made geocoding impossible until after the
/// decision it exists to inform.
enum GeocodeSubject {
  SOURCE_LISTING
  LOCATION
  PROPERTY
}

/// One geocode of one subject.
///
/// Exactly one of `propertyId` / `sourceListingId` / `locationId` is set, and
/// `subject` must agree with which. Prisma cannot express that, so it is a CHECK
/// constraint in the migration - together with partial unique indexes that make
/// "one geocode per subject per provider" enforceable even though all three key
/// columns are nullable. One row per provider is deliberate: when a second
/// provider disagrees, both opinions are worth keeping, and `reviewStatus`
/// records which one a human accepted.
model GeocodeRecord {
  id                String              @id @default(cuid())
  subject           GeocodeSubject
  propertyId        String?
  sourceListingId   String?
  locationId        String?
  provider          String
  /// What we asked the provider.
  query             String
  /// The canonical address we recorded. The source's own wording is never
  /// overwritten - both are kept, so our interpretation can be re-derived.
  normalizedAddress String?
  latitude          Float
  longitude         Float
  confidenceBps     Int?
  precision         LocationPrecision
  reviewStatus      GeocodeReviewStatus @default(PENDING)
  observedAt        DateTime
  rawResponse       Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  property      Property?      @relation(fields: [propertyId], references: [id])
  sourceListing SourceListing? @relation(fields: [sourceListingId], references: [id])
  location      Location?      @relation(fields: [locationId], references: [id])

  @@index([subject])
  @@index([propertyId])
  @@index([sourceListingId])
  @@index([locationId])
}

enum MatchDecisionType {
  AUTO_MERGED
  REVIEW_APPROVED
  REVIEW_REJECTED
  SPLIT
  LEFT_SEPARATE
}

model MatchDecision {
  id                   String            @id @default(cuid())
  leftType             String
  leftId               String
  rightType            String
  rightId              String
  strategy             String
  ruleVersion          String
  scoreBps             Int?
  decision             MatchDecisionType
  evidence             Json
  decidedBy            String?
  decidedAt            DateTime          @default(now())
  reversedByDecisionId String?

  @@index([leftType, leftId])
  @@index([rightType, rightId])
  @@index([decision, decidedAt])
}

model Amenity {
  id          String   @id @default(cuid())
  key         String   @unique
  displayName String
  createdAt   DateTime @default(now())

  aliases       AmenityAlias[]
  propertyLinks PropertyAmenity[]
  sourceLinks   SourceListingAmenity[]
}

model AmenityAlias {
  id                String   @id @default(cuid())
  amenityId         String
  source            String?
  sourceWording     String
  normalizedWording String
  mappingVersion    String
  createdAt         DateTime @default(now())

  amenity Amenity @relation(fields: [amenityId], references: [id])

  @@unique([amenityId, source, normalizedWording])
}

model PropertyAmenity {
  propertyId     String
  amenityId      String
  confidenceBps  Int?
  decidedBy      String
  mappingVersion String
  createdAt      DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  amenity  Amenity  @relation(fields: [amenityId], references: [id])

  @@id([propertyId, amenityId])
}

model SourceListingAmenity {
  sourceListingId String
  amenityId       String
  sourceWording   String
  confidenceBps   Int?
  decidedBy       String
  mappingVersion  String
  createdAt       DateTime @default(now())

  sourceListing SourceListing @relation(fields: [sourceListingId], references: [id])
  amenity       Amenity       @relation(fields: [amenityId], references: [id])

  @@id([sourceListingId, amenityId])
}

enum AvailabilitySignalState {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
  REQUIRES_CONFIRMATION
}

model AvailabilitySignal {
  id            String                  @id @default(cuid())
  propertyId    String?
  unitId        String?
  state         AvailabilitySignalState
  source        String
  observedAt    DateTime
  expiresAt     DateTime?
  confidenceBps Int?
  createdAt     DateTime                @default(now())

  property Property? @relation(fields: [propertyId], references: [id])
  unit     Unit?     @relation(fields: [unitId], references: [id])

  @@index([propertyId, observedAt])
  @@index([unitId, observedAt])
}

// ---------------------------------------------------------------------------
// Supply side
// ---------------------------------------------------------------------------

model InventoryPartner {
  id                      String        @id @default(cuid())
  stateCode               String
  areaId                  String?
  legalName               String
  displayName             String
  contactEmail            String
  contactPhone            String
  status                  PartnerStatus @default(ONBOARDING)
  /// The partner signed the supply agreement: our fee is disclosed and the
  /// partner is named on the listing. Without this, nothing is listed.
  supplyAgreementRef      String?
  supplyAgreementSignedAt DateTime?
  paystackSubaccountCode  String?       @unique
  flutterwaveSubaccountId String?
  settlementBankName      String?
  settlementAccountName   String?
  settlementAccountNumber String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  state     State            @relation(fields: [stateCode], references: [code])
  area      Area?            @relation(fields: [areaId], references: [id])
  channels  PartnerChannel[]
  units     Unit[]
  bookings  Booking[]
  /// Photographs licensed to us under this partner's supply agreement.
  media     MediaAsset[]
  operators Operator[]

  @@index([stateCode, status])
}

enum PartnerStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

/// One row per authorised inventory feed. `kind` mirrors InventoryChannelKind.
model PartnerChannel {
  id                     String             @id @default(cuid())
  partnerId              String
  kind                   ChannelKind
  status                 ChannelStatus      @default(ACTIVE)
  /// Contract id / affiliate publisher id / feed owner. Mandatory paper trail.
  authorizationReference String
  authorizationBasis     AuthorizationBasis
  authorizationGrantedAt DateTime
  authorizationExpiresAt DateTime?
  /// Non-secret config (base URLs, paths, declared origin). Secrets live in a
  /// managed secret store and are referenced by name, never stored here.
  config                 Json
  secretRef              String?
  lastSyncedAt           DateTime?
  lastSyncError          String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  partner InventoryPartner @relation(fields: [partnerId], references: [id])

  @@unique([partnerId, kind])
  @@index([status, lastSyncedAt])
}

enum ChannelKind {
  PARTNER_API
  ICAL_FEED
  PARTNER_DASHBOARD
  AFFILIATE_PROGRAM
}

enum AuthorizationBasis {
  SIGNED_SUPPLY_AGREEMENT
  API_CREDENTIALS_ISSUED
  PARTNER_PUBLISHED_FEED
  AFFILIATE_PROGRAM_TERMS
}

enum ChannelStatus {
  ACTIVE
  PAUSED
  REVOKED
}

model Unit {
  id                        String     @id @default(cuid())
  partnerId                 String
  externalId                String
  name                      String
  unitType                  UnitType
  maxGuests                 Int
  bedrooms                  Int
  bathrooms                 Int
  /// The partner's OWN published nightly rate. House3 never overwrites this.
  nightlyRateKobo           Int
  cleaningFeeKobo           Int        @default(0)
  extraGuestFeePerNightKobo Int        @default(0)
  includedGuests            Int        @default(2)
  minNights                 Int        @default(1)
  maxNights                 Int        @default(30)
  /// false = affiliate/redirect inventory with no instant-book calendar.
  bookable                  Boolean    @default(true)
  deepLinkBaseUrl           String?
  /// Attribution shown on the listing page, e.g. "Lekki Homes Ltd".
  partnerDisplayName        String?
  status                    UnitStatus @default(DRAFT)

  /// Surveyed coordinates. Null until onboarding captures them - never inferred
  /// from the area name, because a wrong pin sends a guest to the wrong street.
  latitude  Float?
  longitude Float?
  /// Latitude/longitude pair for PostGIS. Enable the extension with
  ///   CREATE EXTENSION IF NOT EXISTS postgis;
  /// then uncomment, backfill from latitude/longitude, and add:
  ///   CREATE INDEX unit_geog_idx ON "Unit" USING GIST (geog);
  /// Prisma cannot express GiST indexes, so that index lives in a migration.
  /// Until then the two-stage bounding-box filter in src/domain/geo.ts keeps the
  /// in-memory and Spark/SQL paths behaving identically.
  // geog                    Unsupported("geography(Point, 4326)")?

  /// Property title. Filters on this are what make this a Nigerian platform:
  /// buyers ask about title before almost anything else.
  titleDocument TitleDocument @default(NOT_DISCLOSED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner             InventoryPartner     @relation(fields: [partnerId], references: [id])
  availability        UnitNight[]
  holds               Hold[]
  bookings            Booking[]
  media               MediaAsset[]
  availabilitySignals AvailabilitySignal[]

  @@unique([partnerId, externalId])
  @@index([status])
}

enum UnitType {
  APARTMENT
  STUDIO
  ROOM
  HOSTEL_BED
  VILLA
}

enum UnitStatus {
  DRAFT
  LISTED
  HIDDEN
  ARCHIVED
}

/// Mirrors src/domain/title.ts. Kept in sync by hand; the domain constants are
/// the source of truth because the UI needs the labels and descriptions too.
enum TitleDocument {
  C_OF_O
  GOVERNORS_CONSENT
  DEED_OF_ASSIGNMENT
  EXCISION_GAZETTE
  RIGHT_OF_OCCUPANCY
  FREEHOLD
  REGISTERED_DEED
  UNREGISTERED
  NOT_DISCLOSED
}

model UnitNight {
  id              String      @id @default(cuid())
  unitId          String
  night           DateTime    @db.Date
  state           NightState
  nightlyRateKobo Int?
  source          NightSource
  syncedAt        DateTime    @default(now())

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, night])
  @@index([night, state])
}

enum NightState {
  OPEN
  CLOSED
  ON_REQUEST
}

enum NightSource {
  PARTNER_API
  ICAL_FEED
  PARTNER_DASHBOARD
  BOOKING
}

// ---------------------------------------------------------------------------
// Pricing configuration
// ---------------------------------------------------------------------------

model FeePolicy {
  id                String      @id @default(cuid())
  scope             PolicyScope
  /// State code for STATE scope, partner id for PARTNER scope, null for GLOBAL.
  subjectId         String?
  stateCode         String?
  rateBps           Int
  minFeeKobo        Int
  maxFeeKobo        Int?
  minNightlyFeeKobo Int?
  vatRateBps        Int         @default(750)
  roundingStepKobo  Int         @default(5000)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  state State? @relation(fields: [stateCode], references: [code])

  @@index([scope, subjectId, active])
}

enum PolicyScope {
  GLOBAL
  STATE
  PARTNER
}

model LengthOfStayDiscountRule {
  id          String  @id @default(cuid())
  unitId      String?
  partnerId   String?
  stateCode   String?
  label       String
  minNights   Int
  discountBps Int

  @@index([unitId])
  @@index([partnerId])
  @@index([stateCode])
}

// ---------------------------------------------------------------------------
// Booking & money movement
// ---------------------------------------------------------------------------

model Hold {
  id        String     @id @default(cuid())
  unitId    String
  checkIn   DateTime   @db.Date
  checkOut  DateTime   @db.Date
  status    HoldStatus @default(ACTIVE)
  expiresAt DateTime
  bookingId String?
  createdAt DateTime   @default(now())

  unit Unit @relation(fields: [unitId], references: [id])

  @@index([unitId, status, expiresAt])
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

model Booking {
  id        String        @id @default(cuid())
  reference String        @unique
  status    BookingStatus @default(DRAFT)
  partnerId String
  unitId    String
  stateCode String

  guestName  String
  guestEmail String
  guestPhone String
  adults     Int    @default(2)
  children   Int    @default(0)

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  nights   Int

  // Frozen, auditable money snapshot. All integer kobo.
  policyId          String
  roomSubtotalKobo  Int
  discountTotalKobo Int        @default(0)
  serviceFeeKobo    Int
  serviceFeeVatKobo Int        @default(0)
  cleaningFeeKobo   Int        @default(0)
  totalKobo         Int
  partnerNetKobo    Int
  platformNetKobo   Int
  processorFeeKobo  Int        @default(0)
  processor         Processor?
  /// The exact line items shown to the guest at checkout.
  priceBreakdown    Json

  holdExpiresAt DateTime?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner  InventoryPartner @relation(fields: [partnerId], references: [id])
  unit     Unit             @relation(fields: [unitId], references: [id])
  payments Payment[]
  ledger   LedgerEntry[]
  events   BookingEvent[]

  @@index([status, createdAt])
  @@index([guestEmail])
  @@index([unitId, checkIn, checkOut])
  @@index([stateCode, createdAt])
}

enum BookingStatus {
  DRAFT
  HELD
  AWAITING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum Processor {
  PAYSTACK
  FLUTTERWAVE
}

model Payment {
  id           String        @id @default(cuid())
  bookingId    String
  processor    Processor
  processorRef String        @unique
  amountKobo   Int
  status       PaymentStatus @default(PENDING)
  /// Raw webhook payload, kept as dispute evidence.
  rawPayload   Json?
  verifiedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, status])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

/// One row per recipient per booking: the audit trail for "who got what".
model LedgerEntry {
  id            String          @id @default(cuid())
  bookingId     String
  recipient     LedgerRecipient
  kind          LedgerKind
  amountKobo    Int
  status        LedgerStatus    @default(PENDING)
  /// Paystack/Flutterwave settlement or transfer reference.
  settlementRef String?
  settledAt     DateTime?
  createdAt     DateTime        @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([recipient, status])
  @@index([bookingId])
}

enum LedgerRecipient {
  PARTNER
  PLATFORM
}

enum LedgerKind {
  ROOM_REVENUE
  CLEANING_PASSTHROUGH
  SERVICE_FEE
  SERVICE_FEE_VAT
  PROCESSOR_FEE
  REFUND
}

enum LedgerStatus {
  PENDING
  SETTLED
  REVERSED
}

model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actor      String
  note       String?
  createdAt  DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
}

/// Replay protection: a signed webhook is stored once, keyed by its signature.
model WebhookEvent {
  id          String    @id @default(cuid())
  processor   Processor
  eventType   String
  signature   String
  rawBody     String
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([processor, signature])
  @@index([processedAt])
}

/// A photograph we are licensed to display.
///
/// There is no such thing as an asset without a licence reference. Photographs
/// on another operator's listing belong to them or to their photographer, and
/// permission to crawl a page is not permission to republish the pictures on it.
/// Media reaches this table one of three ways, and all three involve a person
/// agreeing to something: the partner uploads it under the supply agreement, we
/// commission a shoot, or we buy a licence.
model MediaAsset {
  id               String       @id @default(cuid())
  partnerId        String
  /// Null for operator-level media such as a logo.
  unitId           String?
  licence          MediaLicence
  /// The contract, commission or licence that permits this use. Required.
  licenceRef       String
  licenceGrantedAt DateTime
  /// Null means open-ended. Required for LICENSED_FEED, which is time-limited
  /// by nature and cannot be audited without an end date.
  licenceExpiresAt DateTime?
  /// Rendering order. Position 0 is the card image.
  position         Int          @default(0)
  /// Our own words. Never lifted from a listing page.
  alt              String
  /// Storage keys, not third-party CDN URLs: a URL we do not control is a
  /// photograph that can be withdrawn or swapped without our knowing.
  variants         Json
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  partner InventoryPartner @relation(fields: [partnerId], references: [id])
  unit    Unit?            @relation(fields: [unitId], references: [id])

  @@index([unitId, position])
  @@index([partnerId, licenceExpiresAt])
}

enum MediaLicence {
  /// The operator uploaded it; the supply agreement covers the use.
  PARTNER_SUPPLIED
  /// We paid a photographer.
  HOUSE3_COMMISSIONED
  /// Bought from a portal or channel manager under a media licence.
  LICENSED_FEED
}
