// House3 production data model.
//
// Design notes:
//  * All money columns are Int, denominated in KOBO. Never Float.
//  * `partnerNetKobo` / `platformNetKobo` / `processorFeeKobo` are stored on the
//    booking itself so the split is reproducible years later, even if fee
//    policies change. Quotes are frozen at checkout time.
//  * PartnerChannel.authorizationReference + expiresAt is what makes an
//    inventory source legal: no authorization row, no sync.
//  * InventoryPartner is always named in the customer UI. There is deliberately
//    no "anonymous supplier" concept in this schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Geography & rollout
// ---------------------------------------------------------------------------

model State {
  code        String      @id // "LA", "FC", "OY", "IM", "AK"
  name        String
  phase       Int
  launchOrder Int         @unique
  status      StateStatus @default(PENDING)
  primaryCity String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  areas    Area[]
  partners InventoryPartner[]
  policies FeePolicy[]

  @@index([status, launchOrder])
}

enum StateStatus {
  PENDING
  SUPPLY_ONBOARDING
  LIVE
  PAUSED
}

model Area {
  id        String   @id @default(cuid())
  stateCode String
  name      String
  /// Sort order for the search dropdown; demand-weighted, not alphabetical.
  rank      Int      @default(100)
  createdAt DateTime @default(now())

  state State @relation(fields: [stateCode], references: [code])
  // Areas belong to a state; partners and units point back at an Area.
  partners InventoryPartner[]

  @@unique([stateCode, name])
  @@index([stateCode, rank])
}

// ---------------------------------------------------------------------------
// Supply side
// ---------------------------------------------------------------------------

model InventoryPartner {
  id                      String        @id @default(cuid())
  stateCode               String
  areaId                  String?
  legalName               String
  displayName             String
  contactEmail            String
  contactPhone            String
  status                  PartnerStatus @default(ONBOARDING)
  /// The partner signed the supply agreement: our fee is disclosed and the
  /// partner is named on the listing. Without this, nothing is listed.
  supplyAgreementRef      String?
  supplyAgreementSignedAt DateTime?
  paystackSubaccountCode  String?       @unique
  flutterwaveSubaccountId String?
  settlementBankName      String?
  settlementAccountName   String?
  settlementAccountNumber String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  state    State            @relation(fields: [stateCode], references: [code])
  area     Area?            @relation(fields: [areaId], references: [id])
  channels PartnerChannel[]
  units    Unit[]
  bookings Booking[]
  /// Photographs licensed to us under this partner's supply agreement.
  media    MediaAsset[]

  @@index([stateCode, status])
}

enum PartnerStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

/// One row per authorised inventory feed. `kind` mirrors InventoryChannelKind.
model PartnerChannel {
  id                     String               @id @default(cuid())
  partnerId              String
  kind                   ChannelKind
  status                 ChannelStatus        @default(ACTIVE)
  /// Contract id / affiliate publisher id / feed owner. Mandatory paper trail.
  authorizationReference String
  authorizationBasis     AuthorizationBasis
  authorizationGrantedAt DateTime
  authorizationExpiresAt DateTime?
  /// Non-secret config (base URLs, paths, declared origin). Secrets live in a
  /// managed secret store and are referenced by name, never stored here.
  config                 Json
  secretRef              String?
  lastSyncedAt           DateTime?
  lastSyncError          String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  partner InventoryPartner @relation(fields: [partnerId], references: [id])

  @@unique([partnerId, kind])
  @@index([status, lastSyncedAt])
}

enum ChannelKind {
  PARTNER_API
  ICAL_FEED
  PARTNER_DASHBOARD
  AFFILIATE_PROGRAM
}

enum AuthorizationBasis {
  SIGNED_SUPPLY_AGREEMENT
  API_CREDENTIALS_ISSUED
  PARTNER_PUBLISHED_FEED
  AFFILIATE_PROGRAM_TERMS
}

enum ChannelStatus {
  ACTIVE
  PAUSED
  REVOKED
}


model Unit {
  id                         String     @id @default(cuid())
  partnerId                  String
  externalId                 String
  name                       String
  unitType                   UnitType
  maxGuests                  Int
  bedrooms                   Int
  bathrooms                  Int
  /// The partner's OWN published nightly rate. House3 never overwrites this.
  nightlyRateKobo            Int
  cleaningFeeKobo            Int        @default(0)
  extraGuestFeePerNightKobo  Int        @default(0)
  includedGuests             Int        @default(2)
  minNights                  Int        @default(1)
  maxNights                  Int        @default(30)
  /// false = affiliate/redirect inventory with no instant-book calendar.
  bookable                   Boolean    @default(true)
  deepLinkBaseUrl            String?
  /// Attribution shown on the listing page, e.g. "Lekki Homes Ltd".
  partnerDisplayName         String?
  status                     UnitStatus @default(DRAFT)

  /// Surveyed coordinates. Null until onboarding captures them - never inferred
  /// from the area name, because a wrong pin sends a guest to the wrong street.
  latitude                   Float?
  longitude                  Float?
  /// Latitude/longitude pair for PostGIS. Enable the extension with
  ///   CREATE EXTENSION IF NOT EXISTS postgis;
  /// then uncomment, backfill from latitude/longitude, and add:
  ///   CREATE INDEX unit_geog_idx ON "Unit" USING GIST (geog);
  /// Prisma cannot express GiST indexes, so that index lives in a migration.
  /// Until then the two-stage bounding-box filter in src/domain/geo.ts keeps the
  /// in-memory and Spark/SQL paths behaving identically.
  // geog                    Unsupported("geography(Point, 4326)")?

  /// Property title. Filters on this are what make this a Nigerian platform:
  /// buyers ask about title before almost anything else.
  titleDocument              TitleDocument @default(NOT_DISCLOSED)

  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  partner      InventoryPartner @relation(fields: [partnerId], references: [id])
  availability UnitNight[]
  holds        Hold[]
  bookings     Booking[]
  media        MediaAsset[]

  @@unique([partnerId, externalId])
  @@index([status])
}

enum UnitType {
  APARTMENT
  STUDIO
  ROOM
  HOSTEL_BED
  VILLA
}

enum UnitStatus {
  DRAFT
  LISTED
  HIDDEN
  ARCHIVED
}

/// Mirrors src/domain/title.ts. Kept in sync by hand; the domain constants are
/// the source of truth because the UI needs the labels and descriptions too.
enum TitleDocument {
  C_OF_O
  GOVERNORS_CONSENT
  DEED_OF_ASSIGNMENT
  EXCISION_GAZETTE
  RIGHT_OF_OCCUPANCY
  FREEHOLD
  REGISTERED_DEED
  UNREGISTERED
  NOT_DISCLOSED
}

model UnitNight {
  id              String      @id @default(cuid())
  unitId          String
  night           DateTime    @db.Date
  state           NightState
  nightlyRateKobo Int?
  source          NightSource
  syncedAt        DateTime    @default(now())

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, night])
  @@index([night, state])
}

enum NightState {
  OPEN
  CLOSED
  ON_REQUEST
}

enum NightSource {
  PARTNER_API
  ICAL_FEED
  PARTNER_DASHBOARD
  BOOKING
}

// ---------------------------------------------------------------------------
// Pricing configuration
// ---------------------------------------------------------------------------

model FeePolicy {
  id                String      @id @default(cuid())
  scope             PolicyScope
  /// State code for STATE scope, partner id for PARTNER scope, null for GLOBAL.
  subjectId         String?
  stateCode         String?
  rateBps           Int
  minFeeKobo        Int
  maxFeeKobo        Int?
  minNightlyFeeKobo Int?
  vatRateBps        Int         @default(750)
  roundingStepKobo  Int         @default(5000)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  state State? @relation(fields: [stateCode], references: [code])

  @@index([scope, subjectId, active])
}

enum PolicyScope {
  GLOBAL
  STATE
  PARTNER
}

model LengthOfStayDiscountRule {
  id          String  @id @default(cuid())
  unitId      String?
  partnerId   String?
  stateCode   String?
  label       String
  minNights   Int
  discountBps Int

  @@index([unitId])
  @@index([partnerId])
  @@index([stateCode])
}

// ---------------------------------------------------------------------------
// Booking & money movement
// ---------------------------------------------------------------------------

model Hold {
  id        String     @id @default(cuid())
  unitId    String
  checkIn   DateTime   @db.Date
  checkOut  DateTime   @db.Date
  status    HoldStatus @default(ACTIVE)
  expiresAt DateTime
  bookingId String?
  createdAt DateTime   @default(now())

  unit Unit @relation(fields: [unitId], references: [id])

  @@index([unitId, status, expiresAt])
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

model Booking {
  id        String        @id @default(cuid())
  reference String        @unique
  status    BookingStatus @default(DRAFT)
  partnerId String
  unitId    String
  stateCode String

  guestName  String
  guestEmail String
  guestPhone String
  adults     Int           @default(2)
  children   Int           @default(0)

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  nights   Int

  // Frozen, auditable money snapshot. All integer kobo.
  policyId          String
  roomSubtotalKobo  Int
  discountTotalKobo Int    @default(0)
  serviceFeeKobo    Int
  serviceFeeVatKobo Int    @default(0)
  cleaningFeeKobo   Int    @default(0)
  totalKobo         Int
  partnerNetKobo    Int
  platformNetKobo   Int
  processorFeeKobo  Int    @default(0)
  processor         Processor?
  /// The exact line items shown to the guest at checkout.
  priceBreakdown    Json

  holdExpiresAt DateTime?
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner  InventoryPartner @relation(fields: [partnerId], references: [id])
  unit     Unit             @relation(fields: [unitId], references: [id])
  payments Payment[]
  ledger   LedgerEntry[]
  events   BookingEvent[]

  @@index([status, createdAt])
  @@index([guestEmail])
  @@index([unitId, checkIn, checkOut])
  @@index([stateCode, createdAt])
}

enum BookingStatus {
  DRAFT
  HELD
  AWAITING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum Processor {
  PAYSTACK
  FLUTTERWAVE
}

model Payment {
  id           String        @id @default(cuid())
  bookingId    String
  processor    Processor
  processorRef String        @unique
  amountKobo   Int
  status       PaymentStatus @default(PENDING)
  /// Raw webhook payload, kept as dispute evidence.
  rawPayload   Json?
  verifiedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, status])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

/// One row per recipient per booking: the audit trail for "who got what".
model LedgerEntry {
  id            String          @id @default(cuid())
  bookingId     String
  recipient     LedgerRecipient
  kind          LedgerKind
  amountKobo    Int
  status        LedgerStatus    @default(PENDING)
  /// Paystack/Flutterwave settlement or transfer reference.
  settlementRef String?
  settledAt     DateTime?
  createdAt     DateTime        @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([recipient, status])
  @@index([bookingId])
}

enum LedgerRecipient {
  PARTNER
  PLATFORM
}

enum LedgerKind {
  ROOM_REVENUE
  CLEANING_PASSTHROUGH
  SERVICE_FEE
  SERVICE_FEE_VAT
  PROCESSOR_FEE
  REFUND
}

enum LedgerStatus {
  PENDING
  SETTLED
  REVERSED
}

model BookingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actor      String
  note       String?
  createdAt  DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
}

/// Replay protection: a signed webhook is stored once, keyed by its signature.
model WebhookEvent {
  id          String    @id @default(cuid())
  processor   Processor
  eventType   String
  signature   String
  rawBody     String
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([processor, signature])
  @@index([processedAt])
}

/// A photograph we are licensed to display.
///
/// There is no such thing as an asset without a licence reference. Photographs
/// on another operator's listing belong to them or to their photographer, and
/// permission to crawl a page is not permission to republish the pictures on it.
/// Media reaches this table one of three ways, and all three involve a person
/// agreeing to something: the partner uploads it under the supply agreement, we
/// commission a shoot, or we buy a licence.
model MediaAsset {
  id                String       @id @default(cuid())
  partnerId         String
  /// Null for operator-level media such as a logo.
  unitId            String?
  licence           MediaLicence
  /// The contract, commission or licence that permits this use. Required.
  licenceRef        String
  licenceGrantedAt  DateTime
  /// Null means open-ended. Required for LICENSED_FEED, which is time-limited
  /// by nature and cannot be audited without an end date.
  licenceExpiresAt  DateTime?
  /// Rendering order. Position 0 is the card image.
  position          Int          @default(0)
  /// Our own words. Never lifted from a listing page.
  alt               String
  /// Storage keys, not third-party CDN URLs: a URL we do not control is a
  /// photograph that can be withdrawn or swapped without our knowing.
  variants          Json
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  partner InventoryPartner @relation(fields: [partnerId], references: [id])
  unit    Unit?            @relation(fields: [unitId], references: [id])

  @@index([unitId, position])
  @@index([partnerId, licenceExpiresAt])
}

enum MediaLicence {
  /// The operator uploaded it; the supply agreement covers the use.
  PARTNER_SUPPLIED
  /// We paid a photographer.
  HOUSE3_COMMISSIONED
  /// Bought from a portal or channel manager under a media licence.
  LICENSED_FEED
}

/// One listing seen on someone else's portal, as of one date.
///
/// PROSPECT DATA. This is not inventory and must never be rendered as a rate a
/// guest can pay - see src/domain/provenance.ts, where that rule is a type rather
/// than a convention. It exists to answer two questions honestly: which
/// operators are active where, and how their advertised rates have moved since
/// we started watching.
///
/// No media and no description is stored, in any column, by design.
model ProspectListing {
  id                String    @id @default(cuid())
  source            String
  sourceListingId   String
  sourceUrl         String
  /// The floor of the listing's age: it existed before we found it, by an
  /// unknown amount, so anything derived from this is "at least".
  firstSeenAt       DateTime
  lastSeenAt        DateTime
  advertisedPriceKobo Int?
  currency          String    @default("NGN")
  bedrooms          Int?
  area              String?
  stateCode         String?
  /// Operator-level identity, resolved by the union-find consolidation in
  /// services/acquisition/normalization/dedupe.py.
  operatorKey       String?
  operatorName      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  observations ProspectObservation[]

  @@unique([source, sourceListingId])
  @@index([lastSeenAt])
  @@index([operatorKey])
  @@index([stateCode, area])
}

/// Every sighting of a prospect listing, append-only.
///
/// Kept as rows rather than only as the JSONL ledger so price history survives
/// an operator delisting a page - which is exactly when the history becomes
/// interesting, because a withdrawn listing that reappears at a lower rate is
/// the sharpest acquisition signal we get.
model ProspectObservation {
  id                  String   @id @default(cuid())
  prospectListingId   String
  observedOn          DateTime
  advertisedPriceKobo Int?
  bedrooms            Int?
  area                String?
  createdAt           DateTime @default(now())

  prospectListing ProspectListing @relation(fields: [prospectListingId], references: [id])

  @@unique([prospectListingId, observedOn])
  @@index([observedOn])
}

